# Yerel deneme için (wrangler dev). Bu dosyayı ".dev.vars" adıyla kopyalayın; GERÇEK anahtarları buraya yazmayın, depoya girmez (.gitignore).
DATABASE_URL=postgresql://postgres:pg@127.0.0.1:5432/crm
DIRECT_URL=postgresql://postgres:pg@127.0.0.1:5432/crm
SUPABASE_URL=http://127.0.0.1:9001
SUPABASE_ANON_KEY=yerel-deneme
SUPABASE_SERVICE_ROLE_KEY=svc-test
SUPABASE_JWT_SECRET=test-gizli-anahtar-en-az-32-karakter-olmali-123
IZINLI_EPOSTALAR=ozgur@test.com
AI_API_KEY=
CRON_SECRET=cron-test

# v3.21 — Google ile bağlan. Canlıda yalnızca ilk ikisi girilir (Cloudflare › Variables and Secrets).
# Yerel uçtan uca sınamada (npm run canli:test:google) sahte Google :9002'de çalışır; son iki satır yalnızca bunun içindir.
GOOGLE_CLIENT_ID=test
GOOGLE_CLIENT_SECRET=test
GOOGLE_OAUTH_TABANI=http://127.0.0.1:9002
GOOGLE_PEOPLE_TABANI=http://127.0.0.1:9002
