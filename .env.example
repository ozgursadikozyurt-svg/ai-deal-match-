# Supabase — Project Settings > Database
# Uygulama (Vercel serverless) → Transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.[PROJE]:[SIFRE]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrate & seed → Direct / Session bağlantısı, port 5432
DIRECT_URL="postgresql://postgres.[PROJE]:[SIFRE]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Yapay zekâ (v3.10) — sağlayıcı ve model Ayarlar › Yapay zekâ ekranından seçilir; anahtar yalnızca burada durur.
# Varsayılan: Google Gemini Flash-Lite (ücretsiz katman) → aistudio.google.com → Get API key
AI_API_KEY=""
# (eski ad; AI_API_KEY boşsa bu okunur)
GEMINI_API_KEY=""

# Portföy fotoğrafları (v3.10) — Supabase → Storage → "portfoy" adlı kova (public). Project Settings → API
SUPABASE_URL="https://[PROJE].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
FOTO_KOVA="portfoy"

# Geçerlilik süreleri artık veritabanındaki `ayar` tablosunda (v3.4: satılık/kiralık ayrı) —
# Ayarlar ekranı veya PUT /api/ayarlar. Varsayılanlar: src/lib/domain/gecerlilik.ts

# ─── v3.21 — Google ile bağlan (çift yönlü Google Kişiler) — docs/GOOGLE_BAGLANTI_KURULUMU_v3.21_8Ekim2026.md ───
# Zorunlu olan yalnızca bu ikisi. Google Cloud Console → People API'yi aç → OAuth istemcisi (Web)
# → yönlendirme adresi: <uygulama adresi>/api/entegrasyon/google/geri-donus
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# İsteğe bağlı: boş bırakılırsa kendiliğinden belirlenir
UYGULAMA_URL=""                                     # boşsa isteğin geldiği alan adı kullanılır
ENTEGRASYON_SIFRE_ANAHTARI=""                       # openssl rand -base64 32; boşsa SUPABASE_SERVICE_ROLE_KEY'den türetilir
CRON_SECRET=""                                      # yalnızca dış zamanlayıcı /api/senkron/calistir'ı çağıracaksa (Cloudflare zamanlayıcısı gerektirmez)
# Notion senkronu v3.21'de gizli (src/lib/ozellikler.ts). Yeniden açılırsa:
NOTION_TOKEN=""
# NOTION_DS_KISI=""  NOTION_DS_PORTFOY=""  NOTION_DS_TALEP=""
