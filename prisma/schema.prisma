// ============================================================================
//  OFİS / KULLANICI / DAVET  (v3.20 — çok ofisli altyapı)
//  Her emlak ofisi bir Ofis satırıdır; tek başına çalışan danışman da tek kişilik ofistir.
//  Ofise ait her tabloda ofisId vardır ve süzgeç src/lib/kiracilik.ts'ten zorlanır.
// ============================================================================

enum Rol {
  PLATFORM_YONETICISI
  OFIS_YONETICISI
  DANISMAN
}

enum Plan {
  UCRETSIZ
  PRO
  PRO_PLUS
}

enum OfisDurumu {
  AKTIF
  ASKIDA
}

/// Kaydı yalnızca sahibi mi görür (OZEL) yoksa ofisin tamamı mı (OFIS)
enum Gorunurluk {
  OFIS
  OZEL
}

enum DavetDurumu {
  BEKLIYOR
  KULLANILDI
  IPTAL
}

model Ofis {
  id        String     @id @default(cuid())
  ad        String
  slug      String     @unique
  durum     OfisDurumu @default(AKTIF)
  plan      Plan       @default(UCRETSIZ)
  /// Plan sınırları uygulanmaz (Özyurtlar Gayrimenkul)
  sinirsiz  Boolean    @default(false)
  /// Pro deneme bitişi; null = deneme yok
  denemeBitis DateTime?
  /// İletişim ve künye
  telefon   String?
  sehir     String?
  /// Paylaşım föyündeki imza, çalışma ili gibi ofis künyesi (ayar tablosu ofis başına ayrıca tutulur)
  notlar    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  kullanicilar Kullanici[]
  davetler     Davet[]
  kayitlar     Kayit[]
  kisiler      Kisi[]
  matchler     Match[]
  ayarlar      Ayar[]
  lokasyonAdaylari LokasyonAday[]
  islenmisMesajlar IslenmisMesaj[]
  portalIlanlari   PortalIlan[]
  entegrasyonlar   Entegrasyon[]
  senkronCalismalari SenkronCalisma[]
  senkronCakismalari SenkronCakisma[]
  notionSyncLoglari  NotionSyncLog[]
  ingestionLoglari   IngestionLog[]
  auditLoglari       AuditLog[]
  kayitNotlari       KayitNot[]
  kayitFotolari      KayitFoto[]
  senkronHaricleri   SenkronHaric[]

  @@index([durum])
  @@map("ofis")
}

model Kullanici {
  id      String  @id @default(cuid())
  ofisId  String @default("")
  ofis    Ofis    @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  /// Supabase Auth ile aynı e-posta (giriş bu e-postaya gelen bağlantıyla yapılır)
  eposta  String  @unique
  adSoyad String?
  telefon String?
  rol     Rol     @default(DANISMAN)
  aktif   Boolean @default(true)
  sonGiris DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sahipKayitlar Kayit[] @relation("KayitSahibi")
  sahipKisiler  Kisi[]  @relation("KisiSahibi")
  olusturduguDavetler Davet[] @relation("DavetOlusturan")

  @@index([ofisId, aktif])
  @@map("kullanici")
}

/// Davetle hesap açma: yönetici bir bağlantı üretir, kişi e-postasını doğrulayıp o ofise girer.
model Davet {
  id         String      @id @default(cuid())
  ofisId     String @default("")
  ofis       Ofis        @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  /// Bağlantıdaki gizli kod (SHA-256 özeti saklanır, düz kod yalnızca bir kez gösterilir)
  kodOzeti   String      @unique
  /// Boş bırakılırsa bağlantıyı açan herkes kullanabilir (tek kullanımlık)
  eposta     String?
  rol        Rol         @default(DANISMAN)
  durum      DavetDurumu @default(BEKLIYOR)
  sonKullanma DateTime
  olusturanId String?
  olusturan   Kullanici? @relation("DavetOlusturan", fields: [olusturanId], references: [id], onDelete: SetNull)
  kullanilan  DateTime?
  kullananEposta String?
  createdAt   DateTime   @default(now())

  @@index([ofisId, durum])
  @@map("davet")
}

// ============================================================================
//  LOKASYON MODELLERİ  (Madde 4)
//  Kaynak: PTT posta kodu listesi → prisma/seed/data/*.json (81 il / 973 ilçe / 73.305 yerleşim)
// ============================================================================

model Il {
  id        Int     @id // plaka kodu (7 = Antalya)
  plaka     String  @unique @db.Char(2)
  ad        String
  slug      String  @unique

  ilceler    Ilce[]
  altBolgeler AltBolge[]
  aliaslar   LokasyonAlias[]
  kayitLokasyonlari KayitLokasyon[]
  portalIlanlari PortalIlan[]

  @@map("il")
}

model Ilce {
  id    Int    @id
  ilId  Int
  ad    String
  slug  String

  il          Il            @relation(fields: [ilId], references: [id])
  mahalleler  Mahalle[]
  altBolgeler AltBolge[]
  komsular    IlceKomsuluk[] @relation("IlceKomsu_kaynak")
  komsuOlduklari IlceKomsuluk[] @relation("IlceKomsu_hedef")
  aliaslar    LokasyonAlias[]
  kayitLokasyonlari KayitLokasyon[]
  portalIlanlari PortalIlan[]

  @@unique([ilId, slug])
  @@index([ilId])
  @@map("ilce")
}

model Mahalle {
  id              Int          @id @default(autoincrement())
  ilceId          Int
  ad              String       // "Altınova Düden"  (Mah/Köyü eki tip alanında)
  slug            String
  tip             YerlesimTipi @default(MAHALLE)
  bagliOlduguYer  String?      // köy mahallesi ise bağlı köy/belde adı
  postaKodu       String?      @db.VarChar(5)
  enlem           Float?
  boylam          Float?

  ilce            Ilce               @relation(fields: [ilceId], references: [id])
  altBolgeler     AltBolgeMahalle[]
  aliaslar        LokasyonAlias[]
  kayitLokasyonlari KayitLokasyon[]
  portalIlanlari  PortalIlan[]

  @@unique([ilceId, slug])
  @@index([ilceId])
  @@index([ad])
  @@map("mahalle")
}

/// Piyasa bölgesi: resmi sınır değil, emlakçının kullandığı kırılım (Lara, Altınova, OSB…)
/// Birden fazla mahalleyi kapsar; ilçe sınırını aşabilir (ilceId null).
model AltBolge {
  id         Int           @id @default(autoincrement())
  ilId       Int
  ilceId     Int?
  ad         String
  slug       String
  tip        AltBolgeTipi  @default(SEMT)
  aciklama   String?
  dogrulandi Boolean       @default(false) // kullanıcı onaylayana kadar false
  enlem      Float?
  boylam     Float?

  il         Il                @relation(fields: [ilId], references: [id])
  ilce       Ilce?             @relation(fields: [ilceId], references: [id])
  mahalleler AltBolgeMahalle[]
  aliaslar   LokasyonAlias[]
  kayitLokasyonlari KayitLokasyon[]
  portalIlanlari PortalIlan[]

  @@unique([ilId, slug])
  @@map("alt_bolge")
}

model AltBolgeMahalle {
  altBolgeId Int
  mahalleId  Int

  altBolge AltBolge @relation(fields: [altBolgeId], references: [id], onDelete: Cascade)
  mahalle  Mahalle  @relation(fields: [mahalleId], references: [id], onDelete: Cascade)

  @@id([altBolgeId, mahalleId])
  @@map("alt_bolge_mahalle")
}

/// Komşu ilçe ilişkisi — lokasyon puanlamasında -15 (elenmez) kuralı için. Çift yönlü kaydedilir.
model IlceKomsuluk {
  ilceId      Int
  komsuIlceId Int

  ilce      Ilce @relation("IlceKomsu_kaynak", fields: [ilceId], references: [id], onDelete: Cascade)
  komsuIlce Ilce @relation("IlceKomsu_hedef", fields: [komsuIlceId], references: [id], onDelete: Cascade)

  @@id([ilceId, komsuIlceId])
  @@map("ilce_komsuluk")
}

/// Serbest metin → lokasyon çözümleme sözlüğü ("Murtpaşa", "Düden Mh.", "Lara", "OSB")
/// AI ham metni buraya çözer; bulunamazsa kayıt "lokasyonHam" ile işaretlenir.
model LokasyonAlias {
  id         Int              @id @default(autoincrement())
  alias      String           // normalize edilmiş (küçük harf, Türkçe karakter sadeleştirilmiş)
  seviye     LokasyonSeviyesi
  ilId       Int?
  ilceId     Int?
  mahalleId  Int?
  altBolgeId Int?
  kaynak     String?          // "notion", "whatsapp", "manuel", "kullanici", "ogrenme"
  // v3.3 — konum öğrenme
  tip            AliasTipi @default(YAZIM)
  onaylandi      Boolean   @default(true)
  kullanimSayisi Int       @default(0)
  aciklama       String?   // "Cender Otel çevresi — Işıklar'a yakın"
  createdAt      DateTime  @default(now())

  il       Il?       @relation(fields: [ilId], references: [id])
  ilce     Ilce?     @relation(fields: [ilceId], references: [id])
  mahalle  Mahalle?  @relation(fields: [mahalleId], references: [id])
  altBolge AltBolge? @relation(fields: [altBolgeId], references: [id])

  @@unique([alias, seviye, ilId])
  @@index([alias])
  @@map("lokasyon_alias")
}

/// v3.3 — Konum öğrenme adayı. Çözülemeyen ifadeler burada birikir; aynı mesajlarda birlikte geçtiği
/// çözülmüş konumlar sayılır ("cender otel" 5 mesajda "Gençlik" ile geçti). Kullanıcı onaylayınca LokasyonAlias olur.
model LokasyonAday {
  id           String      @id @default(cuid())
  ofisId       String @default("")
  ofis         Ofis        @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  ilId         Int         @default(7)
  ifade        String      // normalize edilmiş
  ornekMetin   String?     // ilk görüldüğü mesajdan kısa alıntı
  gorulme      Int         @default(1)
  /// { "<mahalleId|altBolgeId|ilceId anahtarı>": birlikte geçiş sayısı }
  birlikteGecis Json       @default("{}")
  durum        AdayDurumu  @default(BEKLIYOR)
  sonGorulme   DateTime    @default(now())
  createdAt    DateTime    @default(now())

  @@unique([ofisId, ilId, ifade])
  @@index([durum, gorulme])
  @@index([ofisId])
  @@map("lokasyon_aday")
}

/// v3.3 — Kullanıcının ekrandan değiştirebildiği ayarlar (TTL gün sayıları vb.)
/// v3.20 — ayarlar ofis başına tutulur (birincil anahtar: ofisId + anahtar)
model Ayar {
  ofisId    String @default("")
  ofis      Ofis     @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  anahtar   String         // "ttl"
  deger     Json           // { "PORTFOY": 90, "TALEP": 60, "TALEP_ACIL": 30 }
  updatedAt DateTime @updatedAt

  @@id([ofisId, anahtar])
  @@map("ayar")
}

/// Kayıt ↔ lokasyon (çoktan-çoğa). Portföyde 1 satır (birincil), talepte N satır
/// ("Aksu / Yenigöl / Altınova olur"). Her satır farklı seviyede olabilir.
model KayitLokasyon {
  id         String  @id @default(cuid())
  kayitId    String
  ilId       Int
  ilceId     Int?
  mahalleId  Int?
  altBolgeId Int?
  birincil   Boolean @default(false)
  sira       Int     @default(0)

  kayit    Kayit     @relation(fields: [kayitId], references: [id], onDelete: Cascade)
  il       Il        @relation(fields: [ilId], references: [id])
  ilce     Ilce?     @relation(fields: [ilceId], references: [id])
  mahalle  Mahalle?  @relation(fields: [mahalleId], references: [id])
  altBolge AltBolge? @relation(fields: [altBolgeId], references: [id])

  @@index([kayitId])
  @@index([ilceId])
  @@index([mahalleId])
  @@index([altBolgeId])
  @@map("kayit_lokasyon")
}

// ============================================================================
//  ANA KAYIT (Portföy + Talep)
// ============================================================================

model Kayit {
  id            String       @id @default(cuid())
  /// v3.20 — kaydın ait olduğu ofis
  ofisId        String @default("")
  ofis          Ofis         @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  /// v3.20 — kaydı giren danışman (null = ofis ortak / içe aktarma)
  sahipKullaniciId String?
  sahipKullanici   Kullanici? @relation("KayitSahibi", fields: [sahipKullaniciId], references: [id], onDelete: SetNull)
  /// v3.20 — OFIS: ofisin tamamı görür · OZEL: yalnızca sahibi ve ofis yöneticisi görür
  gorunurluk    Gorunurluk   @default(OFIS)
  tip           KayitTipi
  durum         Durum        @default(ACTIVE)
  aciliyet      Aciliyet     @default(NORMAL)

  // ---- Kategori & işlem (Madde 1) ----
  anaKategori   AnaKategori
  mulkTipi      MulkTipi
  /// Talep "Fabrika veya Depo" diyorsa alternatifler; portföyde "Depo, atölye olarak da kullanılabilir"
  alternatifMulkTipleri MulkTipi[]
  islemTipi     IslemTipi
  alternatifIslemTipleri IslemTipi[]

  // ---- Fiyat ----
  fiyat         Decimal?     @db.Decimal(16, 2) // portföy
  minFiyat      Decimal?     @db.Decimal(16, 2) // talep
  maxFiyat      Decimal?     @db.Decimal(16, 2) // talep
  paraBirimi    ParaBirimi   @default(TRY)
  fiyatPeriyodu FiyatPeriyodu @default(TOPLAM)
  krediyeUygun  Boolean?
  /// v3.15 — takasa açık (portföy ve talep); null = belirtilmemiş. Eşleştirmede iki taraf da true ise küçük bonus.
  takasaAcik    Boolean?

  // ---- Ana alan (hızlı filtre) — detaylar MulkOzellik'te ----
  m2            Float?       // portföy: ana kullanım alanı (brüt)
  netM2         Float?
  minM2         Float?       // talep
  maxM2         Float?       // talep
  m2ToleransYuzde Float?     // talep: esneklik (örn. 20 = ±%20)
  odaSayisi     String?      // "3+1", "5 oda ofis"

  // ---- Lokasyon ----
  lokasyonlar   KayitLokasyon[]
  lokasyonHam   String?      // AI çözemediyse ham metin (manuel eşleme kuyruğu)
  adres         String?
  enlem         Float?
  boylam        Float?

  // ---- Kaynak / sahiplik (Madde 3) ----
  veriKanali      VeriKanali     @default(WHATSAPP)
  ilanSahibiTipi  IlanSahibiTipi @default(BILINMIYOR)
  havuz           Havuz          @default(KENDI_PORTFOY)
  /// v3.5 — yetki belgeli portföy (havuz akışında 1. sıra: Yetkili → CRM → Partner → Web ilanı)
  yetkili         Boolean        @default(false)
  yetkiBitis      DateTime?
  musteriKaynagi  MusteriKaynagi?
  portfoyAlinabilirlik PortfoyAlinabilirlik @default(BILINMIYOR)
  kisiId          String?
  kisi            Kisi?          @relation(fields: [kisiId], references: [id])
  kisiBaglari     KayitKisi[]

  // ---- İletişim snapshot (v2.0) ----
  gondeAdi      String?
  gondeTelefon  String?      // +905xxxxxxxxx
  gondeSirket   String?
  kayitGrubu    String?      // WhatsApp grup adı
  // ---- Kaynak bilgisi (v3.3) ----
  mesajTarihi   DateTime?    // mesajın gönderildiği an (WhatsApp satırındaki tarih-saat)
  kaynakDosya   String?      // içe aktarılan dosya adı ("WhatsApp Sohbeti - EMLAK BORSASI.txt")
  ingestionId   String?      // hangi içe aktarma işinden geldi (IngestionLog.id)

  // ---- Portal (v3.0) ----
  portalUrl       String?
  portalIlanNo    String?
  portalIlanSahibi String?

  // ---- Metin alanları ----
  baslik        String?
  ozet          String?      // AI'ın yapılandırılmış kısa özeti (tek cümle)
  hamMetin      String?      // orijinal mesaj — kısaltılmaz
  operasyonNotu String?
  arsivNotu     String?
  /// v2 uyumluluğu: standart kolona dönüşemeyen nadir şartlar (kontrollü liste, serbest paragraf değil)
  ozelSartlar   String[]

  // ---- Yaşam döngüsü ----
  validUntil          DateTime
  ttlUyariGonderildi  Boolean  @default(false)
  /// v3.20 — mükerrer kontrolü ofis içinde: iki ofis aynı ilanı ayrı ayrı tutabilir
  fingerprint         String

  // ---- Notion ----
  notionId       String?
  notionSonSync  DateTime?
  /// v3.6 — son içe aktarılan Notion alanları (+ __tablo, __duzenleme) ve son geri yazılan değerler
  notionSnapshot Json?
  /// v3.7 — görüşme / not akışı
  gorusmeNotlari KayitNot[]
  /// v3.10 — portföy fotoğrafları (ilk sıradaki = kapak)
  fotolar        KayitFoto[]
  notionGeriYazim Json?

  // ---- AI meta ----
  /// Alan bazlı çıkarım güveni: { "ozellik.elektrikGucuKw": 0.92, ... }
  alanGuvenleri  Json?
  aiModelVersiyon String?

  ozellik       MulkOzellik?
  talepMatchleri   Match[]  @relation("TalepMatch")
  portfoyMatchleri Match[]  @relation("PortfoyMatch")
  portalKaynagi    PortalIlan? @relation("PortalIlanKayit")
  auditLoglari     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ofisId, fingerprint])
  @@unique([ofisId, notionId])
  @@index([ofisId, tip, durum])
  @@index([ofisId, sahipKullaniciId])
  @@index([tip, durum])
  @@index([anaKategori, mulkTipi])
  @@index([islemTipi])
  @@index([validUntil])
  @@index([gondeTelefon])
  @@index([kisiId])
  @@map("kayit")
  @@index([portalIlanNo]) // v3.7 — toplu içe aktarmada aynı ilanı tanımak için
}

// ============================================================================
//  MÜLK ÖZELLİK — STANDART TEKNİK KOLONLAR  (Madde 2)
//  Kayit (iç havuz) veya PortalIlan (dış havuz) ile 1:1. Eşleştirme motoru tek kod yoluyla
//  her iki havuzu da aynı kolonlar üzerinden tarar.
//  Birimler: alan m², uzunluk metre, güç kW / kVA, sıcaklık °C, mesafe metre.
// ============================================================================

model MulkOzellik {
  id           String  @id @default(cuid())
  kayitId      String? @unique
  portalIlanId String? @unique

  // ---- ALANLAR ----
  kapaliAlanM2     Float?
  acikAlanM2       Float?
  arsaAlanM2       Float?
  sundurmaM2       Float?
  ofisAlanM2       Float?
  girisKatM2       Float?   // dükkan zemin kat
  asmaKatM2        Float?
  bodrumM2         Float?
  bolunebilir      Boolean?
  minBolumM2       Float?

  // ---- YÜKSEKLİK ----
  netYukseklikM        Float?
  makasAltiYukseklikM  Float?

  // ---- KAPI & ARAÇ ERİŞİMİ ----
  kapiSayisi        Int?
  kapiGenislikM     Float?
  kapiYukseklikM    Float?
  otomatikKapi      Boolean?
  aracErisimi       AracErisimi?   // girebilen en büyük araç (sıralı)
  tirManevraAlani   Boolean?
  rampa             Boolean?
  rampaSayisi       Int?
  vinc              Boolean?
  vincKapasitesiTon Float?
  yukAsansoru       Boolean?

  // ---- ENERJİ ----
  elektrikGucuKw    Float?   // normalize kW (kVA verildiyse ×0.8 — bkz. ALTYAPI §11)
  elektrikGucuKva   Float?   // ilanda kVA yazıyorsa ham değer
  elektrikGucuHam   String?  // "60 KWA", "400 kw özel trafolu"
  trafo             Boolean?
  trafoGucuKva      Float?
  sanayiElektrigi   Boolean?
  jenerator         Boolean?

  // ---- YANGIN & GÜVENLİK ----
  yanginSistemi     Boolean?  // söndürme tesisatı / hidrant
  sprinkler         Boolean?
  yanginAlgilama    Boolean?
  paratoner         Boolean?

  // ---- HUKUKİ ----
  iskan             Boolean?
  ruhsatDurumu      RuhsatDurumu?
  isyeriAcmaRuhsati Boolean?
  numarataj         Boolean?
  tapuTipi          TapuTipi?
  imarDurumu        ImarDurumu?
  adaNo             String?
  parselNo          String?
  emsalKaks         Float?
  taks              Float?

  // ---- İKLİM / SOĞUK HAVA ----
  sogukHava         Boolean?
  sogukHavaM2       Float?
  sogukHavaMinC     Float?
  sogukHavaMaxC     Float?
  iklimlendirme     Boolean?
  havalandirma      Boolean?
  gidayaUygun       Boolean?

  // ---- YAPI ----
  yapiSistemi       YapiSistemi?
  catiTipi          CatiTipi?
  duvarTipi         DuvarTipi?
  zeminTipi         ZeminTipi?
  zeminYukTasimaTonM2 Float?
  binaYasi          Int?
  katSayisi         Int?
  bulunduguKat      Int?     // 0 = zemin/giriş, -1 = bodrum
  /// v3.15 — TALEPTE istenen katlar (çoklu): "-1" bodrum, "0" giriş/zemin, "1"…"N", "ARA" (ara kat), "SON" (son kat). Portföy tek kat tutar (bulunduguKat).
  istenenKatlar     String[]

  // ---- SOSYAL ALANLAR ----
  ofis              Boolean?
  ofisOdaSayisi     Int?
  wc                Boolean?
  wcSayisi          Int?
  mutfak            Boolean?
  personelAlani     Boolean? // soyunma / duş / yemekhane
  sundurma          Boolean?
  sondaj            Boolean?

  // ---- PERAKENDE / DÜKKAN ----
  cepheUzunluguM    Float?
  cepheSayisi       Int?
  vitrin            Boolean?
  koseKonum         Boolean?
  anaCaddeUzeri     Boolean?
  duzGiris          Boolean?
  asmaKat           Boolean?
  bodrum            Boolean?
  baca              Boolean?
  asansor           Boolean?
  otoparkDurumu     OtoparkDurumu?
  otoparkKapasitesi Int?
  yayaTrafigi       TrafikSeviyesi?
  aracTrafigi       TrafikSeviyesi?

  // ---- ERİŞİLEBİLİRLİK (metre) ----
  anaYolaMesafeM     Int?
  cevreYolunaMesafeM Int?
  havalimaninaMesafeM Int?
  limanaMesafeM      Int?
  denizeMesafeM      Int?
  osbIcinde          Boolean?

  // ---- KULLANIM ----
  /// portföy: uygun olduğu işler | talep: yapılacak iş
  kullanimAmaclari  KullanimAmaci[]

  // ---- KONUT (v3.3) ----
  // Oda sayısı Kayit.odaSayisi'nde ("3+1") — eşleştirmede ayrıştırılır
  banyoSayisi       Int?
  isinmaTipi        IsinmaTipi?
  esyaDurumu        EsyaDurumu?
  siteIcinde        Boolean?
  guvenlik          Boolean?
  balkon            Boolean?
  teras             Boolean?
  bahce             Boolean?
  dubleks           Boolean?
  ebeveynBanyosu    Boolean?
  cepheYonleri      Yon[]
  denizManzarasi    Boolean?
  engelliErisimi    Boolean?

  // ---- TURİSTİK TESİS ----
  otelOdaSayisi     Int?
  yatakKapasitesi   Int?
  yildiz            Int?
  turizmBelgesi     TurizmBelgesi?
  havuz             Boolean?

  // ---- KİRA / DEVİR KOŞULLARI ----
  kiraOdemeSekli    KiraOdemeSekli?
  depozitoAy        Float?
  minKiraSuresiYil  Float?   // talep: istenen süre
  bosalmaTarihi     DateTime?
  kiracili          Boolean?
  mevcutKiraGeliri  Decimal? @db.Decimal(16, 2)
  devirBedeli       Decimal? @db.Decimal(16, 2)
  aidat             Decimal? @db.Decimal(12, 2)

  // ---- TALEP DNA (sadece TALEP kayıtlarında) ----
  kritikKriterler     TeknikAlan[]  // öldürücü: karşılanmazsa UYGUN_DEGIL
  esnekKriterler      TeknikAlan[]
  /// AI tespiti: bu kayıt için kritik ama bilinmeyen alanlar ("4 kritik bilgi eksik")
  eksikBilgiler       TeknikAlan[]

  kayit      Kayit?      @relation(fields: [kayitId], references: [id], onDelete: Cascade)
  portalIlan PortalIlan? @relation(fields: [portalIlanId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  // Ön-filtre (matematik katmanı) için en sık sorgulanan kolonlar
  @@index([kapaliAlanM2])
  @@index([elektrikGucuKw])
  @@index([netYukseklikM])
  @@index([aracErisimi])
  @@index([ruhsatDurumu])
  @@map("mulk_ozellik")
}

// ============================================================================
//  KİŞİ
// ============================================================================

model Kisi {
  id             String         @id @default(cuid())
  /// v3.20 — kişinin ait olduğu ofis
  ofisId         String @default("")
  ofis           Ofis           @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  /// v3.20 — kişiyi ekleyen danışman; müşteri listesi varsayılan olarak danışmana özeldir
  sahipKullaniciId String?
  sahipKullanici   Kullanici?   @relation("KisiSahibi", fields: [sahipKullaniciId], references: [id], onDelete: SetNull)
  gorunurluk     Gorunurluk     @default(OZEL)
  adSoyad        String
  telefon        String?        // normalize +905… (benzersizlik ofis içinde)
  ikincilTelefon String?
  email          String?
  sirket         String?
  /// v3.15 — rol kodları (ALICI, SATICI … + Ayarlar'dan eklenen özel roller). Eskiden KisiRolu enum dizisiydi; artık serbest metin dizisi.
  roller         String[]
  ilanSahibiTipi IlanSahibiTipi @default(BILINMIYOR)
  kaynak         KisiKaynagi    @default(MANUEL)
  notlar         String?
  googleResourceName String?
  notionId       String?
  // v3.6 — senkron: son senkronda dış kaynaktan alınan alanların fotoğrafı (üç yönlü birleştirme için)
  googleEtag     String?
  googleSnapshot Json?
  notionSnapshot Json?
  /// Dış kaynakta silindiğinde (Google/Notion) — kişi Anahtar'da silinmez, yalnızca işaretlenir
  kaynaktaSilindi DateTime?
  /// v3.21 — çift yönlü Google: bu kişi Google Kişiler'e eklenmeyi bekliyor (elle eklenen ya da "Google'a gönder" denen kişi).
  /// Gönderilince null olur ve googleResourceName dolar. Toplu içe aktarılan kişiler kendiliğinden işaretlenmez.
  googleBekliyor  DateTime?
  /// v3.7 — bu kişiyle yapılan görüşme notları
  kayitNotlari   KayitNot[]
  // v3.4 — Notion "Müşteri-Yatırımcılar-Kişiler" alanları
  uzmanlikAileleri String[]     // emlakçılar için: ["DEPO","DUKKAN"] (Notion: EMLAKÇI DEPO / TİCARİ)
  referans       String?
  whatsappGruplari String[]     // mesajlarının görüldüğü gruplar
  sonIletisim    DateTime?

  kayitlar  Kayit[]
  kayitBaglari KayitKisi[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ofisId, telefon])
  @@unique([ofisId, googleResourceName])
  @@unique([ofisId, notionId])
  @@index([adSoyad])
  @@index([ofisId, sahipKullaniciId])
  @@index([ofisId, googleBekliyor])
  @@map("kisi")
}

/// v3.4 — Kayıt ↔ kişi (çoktan-çoğa, rol ile). Kayit.kisiId geriye dönük uyumluluk için kalır (birincil kişi).
model KayitKisi {
  id       String        @id @default(cuid())
  kayitId  String
  kisiId   String
  rol      KayitKisiRolu @default(DIGER)
  birincil Boolean       @default(false)
  kayit    Kayit         @relation(fields: [kayitId], references: [id], onDelete: Cascade)
  kisi     Kisi          @relation(fields: [kisiId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([kayitId, kisiId, rol])
  @@index([kisiId])
  @@map("kayit_kisi")
}

/// v3.4 — Yapay zekâya bir kez gönderilmiş mesajlar. Aynı dosya / aynı mesaj tekrar yüklendiğinde
/// yeniden ayrıştırılmaz (AI kredisi boşa harcanmaz).
model IslenmisMesaj {
  parmakIzi   String            // normalize edilmiş metin özeti
  ofisId      String @default("")
  ofis        Ofis     @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  grup        String?
  mesajTarihi DateTime?
  ingestionId String?
  kayitSayisi Int      @default(0)
  createdAt   DateTime @default(now())

  @@id([ofisId, parmakIzi])
  @@index([grup, mesajTarihi])
  @@map("islenmis_mesaj")
}

// ============================================================================
//  EŞLEŞME
// ============================================================================

model Match {
  id          String     @id @default(cuid())
  ofisId      String @default("")
  ofis        Ofis       @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  talepId     String
  portfoyId   String?
  portalIlanId String?   // dış havuz eşleşmesi
  havuz       Havuz      @default(KENDI_PORTFOY)

  matematikSkor Float
  lokasyonBonus Float    @default(0)
  aiSkor        Float?
  finalSkor     Float
  aiAnaliz      String?

  // v3.0 Aşama 2 — motor mantığı Aşama 3'te
  uygunluk       Uygunluk?
  kritikEngeller TeknikAlan[]
  eksikBilgiler  TeknikAlan[]
  /// Kriter bazlı puan dökümü: { "ELEKTRIK": {"skor":1,"not":"60≥50 kW"}, ... }
  kriterDokumu   Json?

  durum          MatchDurum @default(BEKLIYOR)
  /// v3.8 — "Eşleşmeyi kopar": durum REDDEDILDI + neden (YANLIS, BEGENMEDI, SAHIP_ISTEMEDI, BASKA_ANLASTI, FIYAT, DIGER); bir daha önerilmez
  kopmaNedeni    String?
  koparilma      DateTime?
  operasyonNotu  String?
  notGuncellendi DateTime?

  talepSahibiAdi   String?
  talepSahibiTel   String?
  portfoySahibiAdi String?
  portfoySahibiTel String?

  talep      Kayit       @relation("TalepMatch", fields: [talepId], references: [id], onDelete: Cascade)
  portfoy    Kayit?      @relation("PortfoyMatch", fields: [portfoyId], references: [id], onDelete: Cascade)
  portalIlan PortalIlan? @relation(fields: [portalIlanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([talepId, portfoyId])
  @@unique([talepId, portalIlanId])
  @@index([finalSkor])
  @@index([durum])
  @@index([ofisId])
  @@map("match")
}

// ============================================================================
//  PORTAL İLANI (dış havuz, ham → onay → Kayit)
// ============================================================================

model PortalIlan {
  id             String          @id @default(cuid())
  ofisId         String @default("")
  ofis           Ofis            @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  kanal          VeriKanali
  url            String
  ilanNo         String?
  baslik         String?
  hamIcerik      String?
  ilanSahibiAdi  String?
  ilanSahibiTel  String?
  ilanSahibiTipi IlanSahibiTipi  @default(PORTAL)
  anaKategori    AnaKategori?
  mulkTipi       MulkTipi?
  islemTipi      IslemTipi?
  fiyat          Decimal?        @db.Decimal(16, 2)
  paraBirimi     ParaBirimi      @default(TRY)
  fiyatPeriyodu  FiyatPeriyodu   @default(TOPLAM)
  m2             Float?
  ilId           Int?
  ilceId         Int?
  mahalleId      Int?
  altBolgeId     Int?
  ilkGorulme     DateTime        @default(now())
  sonGorulme     DateTime        @default(now())
  fiyatGecmisi   Json?           // [{tarih, fiyat}] → "fiyat düşmüş" sinyali
  portfoyEdinmeSkoru Float?
  durum          PortalIlanDurum @default(HAM)

  il       Il?       @relation(fields: [ilId], references: [id])
  ilce     Ilce?     @relation(fields: [ilceId], references: [id])
  mahalle  Mahalle?  @relation(fields: [mahalleId], references: [id])
  altBolge AltBolge? @relation(fields: [altBolgeId], references: [id])
  ozellik  MulkOzellik?
  matchler Match[]
  kayitId  String?   @unique
  kayit    Kayit?    @relation("PortalIlanKayit", fields: [kayitId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ofisId, url])
  @@index([kanal, durum])
  @@index([ilceId])
  @@index([ofisId])
  @@map("portal_ilan")
}

// ============================================================================
//  LOG TABLOLARI (v2.0)
// ============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  ofisId    String @default("")
  ofis      Ofis     @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  kayitId   String
  alan      String
  eskiDeger Json?
  yeniDeger Json?
  kaynak    String   @default("kullanici") // kullanici | ai | notion_sync | cron
  kayit     Kayit    @relation(fields: [kayitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([kayitId])
  @@index([ofisId])
  @@map("audit_log")
}

model IngestionLog {
  id            String     @id @default(cuid())
  ofisId        String @default("")
  ofis          Ofis       @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  kanal         VeriKanali
  dosyaAdi      String?
  grupAdi       String?
  toplamMesaj   Int        @default(0)
  gurultu       Int        @default(0)
  yeniKayit     Int        @default(0)
  duplicate     Int        @default(0)
  lokasyonCozulemedi Int   @default(0)
  dosyaParmakIzleri  String[]  // v3.4 — aynı dosyanın tekrar yüklendiğini anlamak için
  oncedenIslenmis    Int      @default(0) // v3.4 — daha önce yapay zekâya gönderildiği için atlanan mesaj
  hata          Int        @default(0)
  detay         Json?
  createdAt     DateTime   @default(now())

  @@index([ofisId])
  @@map("ingestion_log")
}

/// v3.6 — Google Kişiler / Notion bağlantısı (sağlayıcı başına tek satır)
model Entegrasyon {
  id          String               @id @default(cuid())
  ofisId      String @default("")
  ofis        Ofis                 @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  saglayici   EntegrasyonSaglayici
  durum       EntegrasyonDurum     @default(BAGLI_DEGIL)
  hesap       String?              // bağlanan Google e-postası / Notion çalışma alanı
  tokenSifreli String?             // AES-256-GCM (src/lib/guvenlik/sifre.ts) — Google yenileme anahtarı
  syncToken   String?              // Google People API artımlı senkron anahtarı
  /// Notion: tablo başına { sonDuzenleme }; Google: { sayfaToken }
  imlec       Json?
  /// { otomatik, aralikDk, geriYaz, googleYaz (v3.21: çift yönlü), sadeceEtiketler, baglayanKullaniciId, baglanti (ISO), yazmaIzni }
  ayarlar     Json?
  sonSenkron  DateTime?
  sonHata     String?
  kilitBitis  DateTime?            // aynı anda iki senkron çalışmasın
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([ofisId, saglayici])
  @@map("entegrasyon")
}

/// v3.21 — Anahtar'dan silinen kişi dış kaynakta (Google) SİLİNMEZ; ama bir sonraki eşitlemede geri de gelmemelidir.
/// Silinen kişinin dış kimliği ve telefon anahtarı (son 10 hane) burada tutulur; senkron bu listedekileri yeniden eklemez.
/// "Silinenleri yeniden getir" bu listeyi boşaltır.
model SenkronHaric {
  id             String               @id @default(cuid())
  ofisId         String @default("")
  ofis           Ofis                 @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  saglayici      EntegrasyonSaglayici
  /// Google: people/c123… (kişi Google'a bağlı değilken silindiyse boş)
  disKimlik      String?
  /// Telefonun son 10 hanesi (src/lib/senkron/birlestir.ts › telAnahtari)
  telefonAnahtar String?
  ad             String?
  createdAt      DateTime             @default(now())

  @@index([ofisId, saglayici, disKimlik])
  @@index([ofisId, saglayici, telefonAnahtar])
  @@map("senkron_haric")
}

/// v3.6 — her senkron çalışmasının özeti (Bağlantılar ekranındaki geçmiş)
model SenkronCalisma {
  id          String               @id @default(cuid())
  ofisId      String @default("")
  ofis        Ofis                 @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  saglayici   EntegrasyonSaglayici
  tetik       String               @default("zamanlayici") // zamanlayici | kullanici | ilk
  baslangic   DateTime             @default(now())
  bitis       DateTime?
  durum       SyncDurum            @default(BASARILI)
  yeni        Int                  @default(0)
  guncellenen Int                  @default(0)
  baglanan    Int                  @default(0)
  cakisma     Int                  @default(0)
  atlanan     Int                  @default(0)
  silinen     Int                  @default(0)
  geriYazilan Int                  @default(0)
  /// Zaman bütçesi doldu, kalan sayfalar bir sonraki çalışmada
  devamEdecek Boolean              @default(false)
  ozet        Json?
  hata        String?

  @@index([saglayici, baslangic])
  @@index([ofisId])
  @@map("senkron_calisma")
}

/// v3.6 — iki tarafta da değişmiş alan: kullanıcı hangisinin kalacağını seçer
model SenkronCakisma {
  id         String               @id @default(cuid())
  ofisId     String @default("")
  ofis       Ofis                 @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  saglayici  EntegrasyonSaglayici
  hedefTip   String               // KISI | KAYIT
  hedefId    String
  alan       String
  onceki     Json?
  yerel      Json?
  uzak       Json?
  durum      CakismaDurum         @default(ACIK)
  createdAt  DateTime             @default(now())
  cozuldu    DateTime?

  @@index([hedefId])
  @@index([durum])
  @@index([ofisId])
  @@map("senkron_cakisma")
}

model NotionSyncLog {
  id        String     @id @default(cuid())
  ofisId    String @default("")
  ofis      Ofis       @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  kayitId   String?
  notionId  String?
  yon       String     @default("supabase_to_notion")
  durum     SyncDurum
  hata      String?
  createdAt DateTime   @default(now())

  @@index([durum])
  @@index([ofisId])
  @@map("notion_sync_log")
}

// ============================================================================
//  v3.7 — GÖRÜŞME / NOT AKIŞI (talep ve portföy içinde)
// ============================================================================
enum NotTuru {
  GORUSME
  ARAMA
  WHATSAPP
  GOSTERIM
  NOT
}

model KayitNot {
  id        String   @id @default(cuid())
  ofisId      String @default("")
  ofis        Ofis     @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  kayitId   String
  kayit     Kayit    @relation(fields: [kayitId], references: [id], onDelete: Cascade)
  tur       NotTuru  @default(NOT)
  metin     String
  kisiId    String?
  kisi      Kisi?    @relation(fields: [kisiId], references: [id], onDelete: SetNull)
  tarih     DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([kayitId, tarih])
  @@index([kisiId])
  @@index([ofisId])
  @@map("kayit_not")
}

/// v3.10 — Portföy fotoğrafı. Dosya Supabase Storage'da (özel kova); burada yalnızca yol ve künye durur.
/// Fotoğraf tarayıcıda küçültülerek yüklenir (uzun kenar 1600 px); kayıt başına en fazla 8 (bkz. src/lib/domain/foto.ts).
model KayitFoto {
  id         String   @id @default(cuid())
  ofisId     String @default("")
  ofis       Ofis     @relation(fields: [ofisId], references: [id], onDelete: Cascade)
  kayitId    String
  kayit      Kayit    @relation(fields: [kayitId], references: [id], onDelete: Cascade)
  /// 0 = kapak
  sira       Int      @default(0)
  ad         String
  /// Kova içindeki yol: <kayitId>/<fotoId>.jpg
  depoYolu   String
  icerikTuru String   @default("image/jpeg")
  en         Int
  boy        Int
  boyut      Int
  createdAt  DateTime @default(now())

  @@index([kayitId, sira])
  @@index([ofisId])
  @@map("kayit_foto")
}