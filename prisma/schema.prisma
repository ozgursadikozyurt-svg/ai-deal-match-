// Anahtar CRM v3.21.2 · 8 Ekim 2026
// ============================================================================
//  Anahtar.ai — Prisma Şeması (AŞAMA 2 v3.1; v3.3: konut, kaynak, konum öğrenme, ayarlar; v3.4: kişi bağları, işlenmiş mesaj; v3.5: yetkili portföy)
//  Tarih: 30 Eylül 2026  |  Önceki: v2.0 (14–18 Eylül 2026)
//
//  v3.0 ile gelenler:
//   1. Genişletilmiş kategori & işlem tipi enum'ları (portal kategori ağacıyla uyumlu)
//   2. MulkOzellik: ticari/endüstriyel teknik donanımlar için STANDART kolonlar
//      (AI serbest metin üretmez → enum/sayı/boolean alanları doldurur)
//   3. İlan sahibi tipi (Malik/Emlakçı/Müteahhit/Firma/Partner/Portal) + veri kanalı ayrımı
//   4. Türkiye geneli Il → Ilce → Mahalle hiyerarşisi + AltBolge (ticari bölge) + alias tablosu
//
//  Konvansiyon: Tüm teknik alanlar NULLABLE.
//   - PORTFÖY kaydında  → mülkün gerçek değeri   (null = bilinmiyor → "eksik bilgi")
//   - TALEP kaydında    → minimum şart / istenen (null = önemsiz)
//   - Boolean? üç durumlu: true = var/şart, false = yok/istenmiyor, null = bilinmiyor/önemsiz
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// v3.14 — Cloudflare Workers için ayrı istemci (runtime = "workerd"); src/lib/db.ts "#prisma-istemci" ile seçer
generator client_worker {
  provider = "prisma-client"
  output   = "../src/generated/prisma-worker"
  runtime  = "workerd"
}

// Prisma 7: bağlantı URL'leri prisma.config.ts'de (Migrate) ve PrismaClient adapter'ında (runtime)
datasource db {
  provider = "postgresql"
}

