// Anahtar CRM v3.23 · 10 Ekim 2026 (v3.14'ten) — Cloudflare Workers yapılandırması (arayüz + API + zamanlayıcı tek projede)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anahtarcrm",
  "main": "src/canli/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist/canli", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"], "binding": "ASSETS" },
  // v3.22.2 — üçüncü zamanlayıcı GÜNDE BİR: 05:00 UTC (TR 08:00) Google Kişiler eşitlemesi (Google'ı bağlı ofisler; bağlı ofis yoksa hiçbir şey yapmaz).
  // Eskiden her 15 dakikaydı; Cloudflare ücretsiz planda CPU sınırını aşıp 503 veriyordu. Anlık ihtiyaç: Kişiler › "Google ile eşitle".
  "triggers": { "crons": ["0 3 * * *", "0 4 * * sun", "0 5 * * *"] },
  "observability": { "enabled": true },
  // v3.17 — Cloudflare panelinden (Settings → Variables and Secrets) elle girilen değişkenler her yayında silinmesin.
  // Bu dosyada "vars" bloğu YOKTUR; keep_vars olmadan wrangler, paneldeki değişkenleri yayın sırasında temizler.
  "keep_vars": true,
  // Gizli değerler Cloudflare panelinde: Settings → Variables and Secrets (bkz. CANLIYA_ALMA_REHBERI):
  //   DATABASE_URL, DIRECT_URL, SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, IZINLI_EPOSTALAR, AI_API_KEY, CRON_SECRET
  //   v3.21 (Google ile bağlan): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET  — bkz. docs/GOOGLE_BAGLANTI_KURULUMU
  //   v3.23 (Gelen kutusu, isteğe bağlı): GELEN_ALAN_ADI — Email Routing bağlı alan adı; yoksa Gmail köprüsü. Bkz. docs/GELEN_KUTUSU_KURULUMU
  //   E-posta işleyicisi (email) kodda hazırdır; Cloudflare › alan adı › Email Routing › Catch-all → "Send to a Worker: anahtarcrm" ile bağlanır.
}
